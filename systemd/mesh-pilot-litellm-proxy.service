[Unit]
Description=Mesh Pilot - OpenAI-compatible Bedrock shim (port 4000) for the Retell voice bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/glitch-grow-ads-agent-private/ops/litellm-proxy
Environment=AWS_REGION=us-east-2
Environment=AWS_REGION_NAME=us-east-2
Environment=SHIM_BEDROCK_MODEL=bedrock/converse/us.anthropic.claude-haiku-4-5-20251001-v1:0
ExecStart=/home/ubuntu/glitch-grow-ads-agent-private/.venv/bin/python -m uvicorn bedrock_shim:app --host 127.0.0.1 --port 4000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
