[Unit]
Description=Mesh Pilot — keep docs/ aligned with commit history (daily catch-up)
Documentation=https://github.com/floating-astronaut/meshpilot-digital-marketing-stack/blob/main/docs/_autosync.yaml
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/glitch-grow-ads-agent-private
Environment=PYTHONPATH=/home/ubuntu/glitch-grow-ads-agent-private/src
EnvironmentFile=/home/ubuntu/glitch-grow-ads-agent-private/.env
EnvironmentFile=/home/ubuntu/glitch-grow-ads-agent-private/.env.grow-dashboard
SyslogIdentifier=mesh-pilot-docs-autosync
# Always pull main first so the runner sees today's commits, then run + push.
# The script branches off main, so a fast-forward push from another session
# while we're running is safe — we'll catch up on the next tick.
ExecStartPre=/usr/bin/git -C /home/ubuntu/glitch-grow-ads-agent-private fetch origin main
ExecStartPre=/usr/bin/git -C /home/ubuntu/glitch-grow-ads-agent-private checkout main
ExecStartPre=/usr/bin/git -C /home/ubuntu/glitch-grow-ads-agent-private merge --ff-only origin/main
ExecStart=/home/ubuntu/glitch-grow-ads-agent-private/.venv/bin/python scripts/docs_autosync.py
# After the run, force-push the docs-autosync branch so both mirrors reflect
# today's state. Force is safe because the branch always gets reset to main HEAD
# before each run — every push is a clean replacement, never a divergence.
ExecStartPost=-/usr/bin/git -C /home/ubuntu/glitch-grow-ads-agent-private push --force-with-lease origin docs-autosync
ExecStartPost=-/usr/bin/git -C /home/ubuntu/glitch-grow-ads-agent-private push --force-with-lease gitlab docs-autosync
# Always return to main so subsequent shell sessions don't trip over docs-autosync.
ExecStartPost=/usr/bin/git -C /home/ubuntu/glitch-grow-ads-agent-private checkout main
