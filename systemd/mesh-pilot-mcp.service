[Unit]
Description=Mesh Pilot public MCP server (free-tier funnel) — MCP-FUNNEL-4
After=network-online.target postgresql.service grow-dashboard.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/glitch-grow-ads-agent-private
EnvironmentFile=/home/ubuntu/glitch-grow-ads-agent-private/.env.grow-dashboard
ExecStart=/home/ubuntu/glitch-grow-ads-agent-private/.venv/bin/python -m meshpilot_dashboard.mcp_server
Restart=on-failure
RestartSec=5
MemoryMax=256M
LimitNOFILE=4096

# Hardening 2026-06-07 (autopilot)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/glitch-grow-ads-agent-private
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
