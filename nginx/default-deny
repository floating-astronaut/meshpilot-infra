server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    
    ssl_certificate /etc/letsencrypt/live/meshpilot.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/meshpilot.app/privkey.pem;
    
    return 444;
}
